<Window x:Class="DsapiMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DsapiMonitor.Controls"
        xmlns:vm="clr-namespace:DsapiMonitor.ViewModels"
        Title="DeepSeek 用量监控"
        Width="300" Height="480"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <vm:UsageTab x:Key="Today">Today</vm:UsageTab>
        <vm:UsageTab x:Key="Month">Month</vm:UsageTab>
    </Window.Resources>

    <Border CornerRadius="20"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Margin="6"
            Background="{StaticResource BgDeepBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.4" ShadowDepth="2" Color="#000000"/>
        </Border.Effect>

        <Border CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="18,18,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="DeepSeek Monitor"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ShowConfigCommand}" ToolTip="设置 API Key">
                                <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="MiniButton_Click" ToolTip="迷你模式">
                                <TextBlock Text="&#x25BC;" FontFamily="Segoe UI" FontSize="8"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click" ToolTip="关闭">
                                <TextBlock Text="&#x2715;" FontFamily="Segoe UI" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 余额卡片 -->
                <Border Grid.Row="1" Margin="14,14,14,8"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="账户余额"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10.5"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BalanceText}"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="Cascadia Code, Consolas"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,2"/>
                        <!-- 余额变化提醒 -->
                        <TextBlock Text="{Binding BalanceChangeText}"
                                   Foreground="#EF4444" FontSize="12"
                                   FontWeight="Bold" FontFamily="Cascadia Code, Consolas"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding HasBalanceChange, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10.5"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 主内容区 -->
                <Grid Grid.Row="2" Margin="14,4">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- API Key 设置面板 -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfiguring}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="DeepSeek API Key" Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Background="#0AFFFFFF" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="10,8">
                                <TextBox Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         Background="Transparent" BorderThickness="0"
                                         MaxLength="64"/>
                            </Border>
                            <TextBlock Text="sk-... 格式，仅本地存储" Foreground="{StaticResource MutedBrush}"
                                       FontSize="9.5" Margin="0,6,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CancelConfigCommand}" Width="Auto"
                                        Padding="14,4" FontSize="10.5"/>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding SaveApiKeyCommand}" Width="Auto"
                                        Padding="14,4" FontSize="10.5"
                                        Foreground="{StaticResource AccentBlueBrush}" Margin="8,0,0,0">
                                    <TextBlock Text="保存" FontSize="10.5"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 用量内容 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfiguring}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab 栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Padding="0,5" Cursor="Hand"
                                    MouseLeftButtonDown="LatencyTab_Click"
                                    Background="{Binding IsLatencyTab, Converter={StaticResource TabBgConverter}}">
                                <TextBlock Text="延迟" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding IsLatencyTab, Converter={StaticResource TabColorConverter}}"/>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Padding="0,5" Cursor="Hand"
                                    MouseLeftButtonDown="TodayTab_Click"
                                    Background="{Binding IsTodayTab, Converter={StaticResource TabBgConverter}}">
                                <TextBlock Text="今日" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding IsTodayTab, Converter={StaticResource TabColorConverter}}"/>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="0,5" Cursor="Hand"
                                    MouseLeftButtonDown="MonthTab_Click"
                                    Background="{Binding IsMonthTab, Converter={StaticResource TabBgConverter}}">
                                <TextBlock Text="本月" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding IsMonthTab, Converter={StaticResource TabColorConverter}}"/>
                            </Border>
                        </Grid>

                        <!-- 延迟内容 -->
                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLatencyTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="API 响应延迟" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10.5" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding LatencyText}" HorizontalAlignment="Right"
                                           FontSize="11" FontFamily="Cascadia Code, Consolas"
                                           Foreground="{StaticResource AccentBlueBrush}"/>
                            </Grid>
                            <Border Height="50" CornerRadius="8" Background="#08FFFFFF" ClipToBounds="True">
                                <controls:MiniChart Values="{Binding LatencyPoints}" MaxValue="2000"
                                                    StrokeBrush="{StaticResource AccentBlueBrush}"
                                                    FillBrush="#203B82F6"/>
                            </Border>
                        </StackPanel>

                        <!-- 今日用量 -->
                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodayTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="今日用量" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding TodayUsageText}" Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="根据余额差值计算，每30秒更新"
                                       Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>

                            <!-- 每日限额 -->
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="10,8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="每日限额" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <Run Text="¥"/><Run Text="{Binding DailyLimitInput, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Border Background="#0AFFFFFF" CornerRadius="6"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="8,4">
                                        <TextBox Text="{Binding DailyLimitInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                 Foreground="{StaticResource ForegroundBrush}"
                                                 Background="Transparent" BorderThickness="0"
                                                 MaxLength="12"/>
                                    </Border>
                                    <TextBlock Text="留空表示不限制，超出后迷你窗口变红警告"
                                               Foreground="{StaticResource MutedBrush}" FontSize="9"
                                               Margin="0,4,0,0"/>
                                    <!-- 超限警告 -->
                                    <Border Background="#20EF4444" CornerRadius="6" Padding="8,5" Margin="0,6,0,0"
                                            BorderBrush="#33EF4444" BorderThickness="1"
                                            Visibility="{Binding IsDailyLimitExceeded, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Foreground="#FCA5A5" FontSize="10.5" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold">
                                            <Run Text="⚠ 今日用量已达 ¥"/><Run Text="{Binding DailyLimitInput, Mode=OneWay}"/><Run Text=" 限额"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 本月用量 -->
                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="本月用量" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding MonthUsageText}" Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="16" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="月初至今累计消耗，跨月自动重置"
                                       Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 错误/诊断 -->
                <Border Grid.Row="3" Margin="14,0,14,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Background="#15EF4444" CornerRadius="6" Padding="8,5"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ErrorText, StringFormat='⚠ {0}'}"
                                       Foreground="#FCA5A5" FontSize="10"/>
                        </Border>
                        <TextBlock Text="{Binding DiagnosticText}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="8.5" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- 底栏 -->
                <Border Grid.Row="4" Margin="14,0,14,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="{Binding LastUpdateText, StringFormat='更新于 {0}'}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="9" FontFamily="Segoe UI"/>
                        <TextBlock Text="打开平台" Foreground="{StaticResource AccentBlueBrush}"
                                   FontSize="9" FontFamily="Segoe UI"
                                   HorizontalAlignment="Right" Cursor="Hand"
                                   MouseLeftButtonDown="DashboardLink_Click"/>
                    </Grid>
                </Border>

                <!-- 余额预警 -->
                <Border Grid.Row="5" Margin="14,0,14,8"
                        Background="#20EF4444" CornerRadius="8" Padding="10,6"
                        BorderBrush="#33EF4444" BorderThickness="1"
                        Visibility="{Binding HasBalanceWarning, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding BalanceWarningText}"
                               Foreground="#FCA5A5" FontSize="10.5"
                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
