<Window x:Class="DsapiMonitor.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 DeepSeek 平台"
        Width="520" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 提示栏 -->
        <Border Grid.Row="0" Background="#18FFFFFF" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText"
                           Text="请在下方登录 DeepSeek 平台，登录成功后点击「登录完成」"
                           Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- WebView2 浏览器 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#18FFFFFF" Padding="12,8">
            <Grid>
                <Button Content="登录完成，开始监控"
                        HorizontalAlignment="Right"
                        Padding="16,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#42A5F5"
                        Background="#1A42A5F5"
                        BorderBrush="#3342A5F5"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="LoginComplete_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3342A5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
