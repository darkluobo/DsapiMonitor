<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Financial Dashboard 深色配色 -->
    <Color x:Key="BgDeep">#FF020617</Color>
    <Color x:Key="BgCard">#FF0E1223</Color>
    <Color x:Key="BgPrimary">#FF0F172A</Color>
    <Color x:Key="BgSecondary">#FF1E293B</Color>
    <Color x:Key="AccentGreen">#FF22C55E</Color>
    <Color x:Key="AccentBlue">#FF3B82F6</Color>
    <Color x:Key="Destructive">#FFEF4444</Color>
    <Color x:Key="Foreground">#FFF8FAFC</Color>
    <Color x:Key="Muted">#FF94A3B8</Color>
    <Color x:Key="Border">#FF334155</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource Destructive}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Foreground}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#15FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
